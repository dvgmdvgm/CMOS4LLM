# CMOS - Cognitive Memory Operating System
# .gitignore

# Rust
target/
**/*.rs.bk
*.pdb

# Node / Frontend
node_modules/
dist/
.vite/
*.tsbuildinfo
package-lock.json

# Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Environment & secrets
.env
.env.*
!.env.example
*.key
*.pem
credentials.json

# CMOS runtime data (not committed)
.cmos/
data/

# Models (too large for git)
models/
*.gguf

# SQLite databases (runtime)
*.db
*.db-wal
*.db-shm

# Lance data (runtime)
*.lance/

# Build artifacts
*.exe
*.dll
*.so
*.dylib

# Logs
*.log

# Claude Code (keep .claude/commands/, exclude runtime)
.claude/settings.json
.claude/settings.local.json
.claude/todos/
.claude/worktrees/
